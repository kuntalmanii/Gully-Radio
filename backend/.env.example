# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Server ──────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────
# URL of the frontend (used by CORS middleware)
FRONTEND_URL=http://localhost:5173

# ─── Future: Database ────────────────────────────────────────────
# DATABASE_URL=

# ─── Future: Auth / JWT ──────────────────────────────────────────
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# ─── Future: Storage ─────────────────────────────────────────────
# CLOUDINARY_URL=
